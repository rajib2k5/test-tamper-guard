diff --git a/sizing/kelly.py b/sizing/kelly.py
index 0851460..d1eb876 100644
--- a/sizing/kelly.py
+++ b/sizing/kelly.py
@@ -4,6 +4,7 @@ log = logging.getLogger(__name__)
 
 
 def kelly_fraction(p_win, payoff):
+    log.debug("kelly p=%s b=%s", p_win, payoff)
     q = 1.0 - p_win
     f = (p_win * payoff - q) / payoff
     return max(0.0, f)
